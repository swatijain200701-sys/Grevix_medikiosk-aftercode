# ==============================================================================
# MediKiosk Environment Configuration
# ==============================================================================
# If left blank, MediKiosk operates in honest unconfigured template fallback mode:
# intake sync is preserved 100%, and structured findings are presented with
# "AI Summary Pending (API key not configured)" without faking live AI responses.

# Optional provider preference ('gemini' | 'openai' | 'groq')
# AI_PROVIDER=gemini

# --- Google Gemini Configuration ---
# GEMINI_API_KEY=your_actual_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash # or gemini-1.5-flash

# --- OpenAI Configuration ---
# OPENAI_API_KEY=your_actual_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini # or gpt-4o

# --- Groq Configuration ---
# GROQ_API_KEY=your_actual_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile